@page "/dashboard"
@using Frontend.Components.Dashboard
@using Frontend.Models

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

<div class="dashboard-overview">
	@if (data is null)
	{
		<p>Loading Games...</p>
	}
	else
	{
		<GameList Games="data.Games"></GameList>
	}
	<LobbyCreation></LobbyCreation>
	@if (data is null)
	{
		<p>Loading Profile...</p>
	}
	else
	{
		<UserInfo Friends="data.Friends"></UserInfo>
	}
</div>

@code {
	/*
	 * This part is the init parts
	 * with all the variables, could be one call?
	 * or do the login thing that I mentioned in the commits
	*/
	protected override async Task OnInitializedAsync()
	{
		await GetSetDashboardData();
	}

	private DashboardData? data;

	/*
	 * Here are the wrappers that would go towards the Requests
	 * as per for sending to the backend and setting the above ones
	*/
	private async Task GetSetDashboardData()
	{
		// all Temporary for testing the logic
		// but I would say should be working fine
		data = new DashboardData(
		Games: [
			new GameLobby("Bruh", "what's up"),
			new GameLobby("Second", "Some More Data")
			],
		Friends: [
			new Friend("Yoo", "More text"),
			new Friend("Another", "Plus something")
		]);
		// data = null;
	}
}
