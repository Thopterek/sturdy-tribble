@page "/dashboard"
@using Frontend.Components.Dashboard

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

<div class="dashboard-overview">
	<GameList count="@games_count"></GameList>
	<LobbyCreation></LobbyCreation>
	<UserInfo count="@friends_count"></UserInfo>
</div>

@code {
	[Parameter, EditorRequired] public int friends_count { get; set; } = 0;
	[Parameter, EditorRequired] public int games_count { get; set; } = 0;
}
