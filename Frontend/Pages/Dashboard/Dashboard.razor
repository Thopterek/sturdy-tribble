@page "/dashboard"
@using Frontend.Components.Dashboard

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

<div class="dashboard-overview">
	<GameList count="@games_count"></GameList>
	<LobbyCreation></LobbyCreation>
	<UserInfo count="@friends_count"></UserInfo>
</div>

@code {
	/*
	 * This part is the init parts
	 * with all the variables
	*/
	protected override void OnInitialized()
	{
		GetSetFriends();
		GetSetGames();
	}
	[EditorRequired] public int friends_count { get; set; } = 0;
	[EditorRequired] public int games_count { get; set; } = 0;
	/*
	 * Here are the wrappers that would go towards the Requests
	 * as per for sending to the backend and setting the above ones
	*/
	private void GetSetFriends()
	{
		friends_count = 0; // tmp
	}
	private void GetSetGames()
	{
		games_count = 0; // tmp
	}
}
