@using Frontend.Layout.Dashboard
@using Frontend.Models

<RectangleMenus Title="Profile" EmptyMsg="@empty_msg" Items="@Friends">
	<SingleItem Context="friend">
		<span>@friend.Name</span>
		<span>@friend.IdkNow</span>
	</SingleItem>
</RectangleMenus>

@code {
	private const string empty_msg = "It looks like you didn't add any friends yet, try finding someone to play";
	[Parameter, EditorRequired] public IReadOnlyList<Friend> Friends { get; set; } = [];
}
